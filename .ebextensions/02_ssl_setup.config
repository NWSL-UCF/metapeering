files:
  "/opt/ssl_manager/certbot_setup.sh":
    mode: "0750"
    owner: root
    group: root
    content: |
      #!/bin/bash

      LOG_DIR="/var/log/certbot"
      LOG_FILE="$LOG_DIR/ssl_setup.log"

      mkdir -p "$LOG_DIR"
      touch "$LOG_FILE"
      exec >> "$LOG_FILE" 2>&1

      echo "=== $(date): Starting SSL provisioning script ==="

      ENV_DOMAIN_NAMES=$(echo $DOMAIN_NAMES)
      if [[ -z "$ENV_DOMAIN_NAMES" ]]; then
          echo "No DOMAIN_NAMES specified, skipping SSL setup."
          exit 0
      fi

      IFS=',' read -ra DOMAIN_NAMES <<< "$ENV_DOMAIN_NAMES"

      for DOMAIN in "${DOMAIN_NAMES[@]}"; do
          DOMAIN=$(echo "$DOMAIN" | xargs)  # Trim whitespace

          echo "Processing domain: $DOMAIN"

          if certbot certificates | grep -q "Certificate Name: $DOMAIN"; then
              echo "Certificate exists for $DOMAIN. Attempting renewal..."
              certbot renew --quiet
          else
              echo "Requesting new certificate for $DOMAIN"
              certbot certonly --nginx -d "$DOMAIN" --non-interactive --agree-tos -m admin@$DOMAIN
          fi

          CONF_PATH="/etc/nginx/conf.d/${DOMAIN}.conf"
          if [[ ! -f "$CONF_PATH" ]]; then
              echo "Creating NGINX config for $DOMAIN"
              cp /var/app/current/.platform/nginx/conf.d/ssl_template.conf.template "$CONF_PATH"
              sed -i "s/__DOMAIN__/$DOMAIN/g" "$CONF_PATH"
          fi
      done

      echo "Reloading NGINX"
      nginx -s reload
      echo "=== $(date): SSL provisioning complete ==="

container_commands:
  00_set_global_env_vars:
    command: |
      echo "DOMAIN_NAMES=\"$DOMAIN_NAMES\"" | sudo tee /etc/environment

  01_add_cron:
    command: |
      echo "0 0 */21 * * root /opt/ssl_manager/certbot_setup.sh >> /var/log/certbot/cron.log 2>&1" > /etc/cron.d/ssl_renew
      chmod 0644 /etc/cron.d/ssl_renew
      crontab /etc/cron.d/ssl_renew

  02_run_certbot_now:
    command: "/opt/ssl_manager/certbot_setup.sh"
